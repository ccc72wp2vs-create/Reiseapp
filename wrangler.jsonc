{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // TRAVIO – Cloudflare Worker + Static Assets + D1
  "name": "travio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "assets": {
    // The SPA is served from Workers Static Assets; unknown paths fall back to
    // index.html. Only /api/* runs the Worker first.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
    "binding": "ASSETS"
  },
  "vars": {
    "APP_ENV": "production",
    "VAPID_SUBJECT": "https://travio.travio-reise.workers.dev",
    // Public half of the Web Push key (not secret); the private half is the
    // Worker secret VAPID_PRIVATE_KEY.
    "VAPID_PUBLIC_KEY": "BMijOPb7FfJ1s1Jukn91xdWiQOZE8Vo0I3wUCJOvkf6PVehLum_g2RZU_gghdIDi4EOS6pus4UiJI1QEcipm7_A"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "travio",
      // Replace with the ID printed by `npx wrangler d1 create travio`.
      "database_id": "857a5ba6-2e84-4655-b1f2-b5a9da0347c1",
      "migrations_dir": "migrations"
    }
  ],
  // Workers AI reads uploaded receipts (documents stay in this account).
  "ai": { "binding": "AI" },
  // Daily ECB reference rates (published ~16:00 CET) for running trips;
  // hourly push reminders (check-in open, travel day tomorrow, balance due).
  "triggers": { "crons": ["20 15 * * *", "20 5 * * *", "0 * * * *"] }
  // Future: private bucket for booking documents (create it first with
  // `npx wrangler r2 bucket create travio-documents`, then uncomment):
  // "r2_buckets": [{ "binding": "DOCUMENTS", "bucket_name": "travio-documents" }]
}
