# Public, build-time configuration for the frontend (Vite). These values end
# up in the JavaScript bundle – never put secrets here.

# Map tile provider (Leaflet URL template). Default: OpenStreetMap standard tiles
# (only suitable for light use – see README "Kartenanbieter").
# VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>
# VITE_MAP_MAX_ZOOM=19
